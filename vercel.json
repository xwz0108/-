{
  "version": 2,
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build", "config": { "buildCommand": "npm run build", "outputDirectory": "dist" } }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "env": {
    "VITE_BAIDU_API_KEY": "@baidu_api_key",
    "VITE_BAIDU_SECRET_KEY": "@baidu_secret_key"
  }
}
